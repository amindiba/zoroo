{
  "name": "zoro-theme-php",
  "description": "وابستگی‌های PHP قالب زورو",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcs-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcs-composer-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=WordPress inc/*.php",
    "lint:fix": "phpcbf --standard=WordPress inc/*.php",
    "compat": "phpcs --standard=PHPCompatibilityWP -p inc/"
  }
}
